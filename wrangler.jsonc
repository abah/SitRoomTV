{
  "name": "sitroom-tv",
  "main": "worker.ts",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/hls*"]
  },
  "routes": [
    {
      "pattern": "tv.abah.me",
      "custom_domain": true
    }
  ]
}
